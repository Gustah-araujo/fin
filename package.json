{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write \"resources/js/**/*.{ts,tsx}\"",
    "lint": "eslint \"resources/js\"",
    "lint:fix": "eslint \"resources/js\" --fix",
    "quality": "eslint \"resources/js\" && prettier --check \"resources/js/**/*.{ts,tsx}\"",
    "cypress:run": "docker compose --profile testing run --rm cypress npx cypress run",
    "cypress:open": "docker compose --profile testing run --rm -e DISPLAY cypress npx cypress open"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^9.0.1",
    "cypress": "^15.18.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@inertiajs/react": "^3.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ziggy-js": "^1.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ziggy-js": "^2.6.3"
  }
}
