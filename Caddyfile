{
    email {$CADDY_EMAIL}
}

{$APP_DOMAIN:localhost} {
    root * /var/www/html/public
    encode zstd gzip
    file_server

    handle_path /build/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    php_fastcgi app:9000

    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 3
        }
    }
}
